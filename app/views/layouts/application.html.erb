<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "My Healthy Map - Find Your Next Healthy Spot" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="My Healthy Map App">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <meta property="og:title" content="<%= content_for(:title) || "My Healthy Map - Find Your Next Healthy Spot" %>">
    <meta property="og:description" content="Discover food, fitness & wellness spots near you, wherever you are in the city.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:image" content="<%= image_url("og-image.png") %>">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="<%= asset_path('icon.png') %>" type="image/png">
    <link rel="icon" href="<%= asset_path('icon.svg') %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= asset_path('icon.png') %>">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>



  <body>
     <%= render "shared/navbar" %>
    <%= render "shared/welcome_modal" if @show_welcome_modal %>
    <%= render "shared/chat_widget" %>

    <% flash.each do |type, message| %>
      <div class="alert alert-<%= type == "notice" ? "success" : "danger" %> mb-0 text-center" role="alert">
        <%= message %>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
