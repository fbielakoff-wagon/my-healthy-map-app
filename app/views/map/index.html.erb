<% content_for :head do %>
  <link
    href="https://api.mapbox.com/mapbox-gl-js/v3.26.0/mapbox-gl.css"
    rel="stylesheet"
  >
<% end %>

<div class="map-page">
  <div
    class="map-experience"
    data-controller="map map-intro"
    data-map-token-value="<%= @mapbox_token %>"
    data-map-spots-value="<%= @spots.to_json(
      only: [:id, :name, :category, :latitude, :longitude, :address],
      methods: [:average_rating, :reviews_count]
    ) %>"
    <% if @center %>
      data-map-center-value="<%= @center.to_json %>"
    <% end %>
  >
    <div class="map-stage">
      <div
        id="map"
        class="map-stage__map"
        data-map-target="mapContainer"
        data-map-intro-target="map">
      </div>

      <section
        class="map-intro"
        data-map-intro-target="intro"
        data-action="
          click->map-intro#reveal
          keydown.enter->map-intro#reveal
          keydown.space->map-intro#reveal
        "
        tabindex="0"
        aria-labelledby="map-intro-heading">

        <div class="map-intro__content">
          <p class="map-intro__eyebrow">
            Welcome to My Healthy Map
          </p>

          <h1
            id="map-intro-heading"
            class="map-intro__heading">
            Find your next healthy spot
          </h1>

          <p class="map-intro__text">
            Discover places to eat well, move more and recharge near you.
          </p>

          <button
            type="button"
            class="map-intro__button"
            data-action="click->map-intro#reveal">
            Explore the map

            <span aria-hidden="true">
              ↓
            </span>
          </button>

          <div class="map-intro__scroll-cue" aria-hidden="true">
              <span>Scroll to explore</span>
               <span class="map-intro__scroll-arrow">↓</span>
          </div>
        </div>
      </section>

      <div
        class="map-controls"
        data-map-intro-target="controls">

        <div class="position-relative">
          <%= form_with url: map_search_path,
                        method: :get,
                        class: "map-controls__search" do %>

            <span
              class="map-controls__search-icon"
              aria-hidden="true">
              <i class="fa-solid fa-magnifying-glass"></i>
            </span>

            <input
              type="text"
              name="address"
              class="form-control"
              autocomplete="off"
              data-map-target="addressInput"
              data-action="input->map#suggestLocations blur->map#hideSuggestionsSoon"
              placeholder="Search by area or address"
              value="<%= params[:address] %>"
              aria-label="Search by area or address"
            >
          <% end %>

          <div
            class="list-group position-absolute w-100"
            data-map-target="suggestions">
          </div>
        </div>

        <div
          class="map-controls__chips"
          aria-label="Filter spots by category">

          <button
            type="button"
            class="chip chip--active"
            data-map-target="filterButton"
            data-action="click->map#filterByCategory"
            data-category="all">
            All
          </button>

          <button
            type="button"
            class="chip"
            data-map-target="filterButton"
            data-action="click->map#filterByCategory"
            data-category="food">
            🥗 Food
          </button>

          <button
            type="button"
            class="chip"
            data-map-target="filterButton"
            data-action="click->map#filterByCategory"
            data-category="fitness">
            💪 Fitness
          </button>

          <button
            type="button"
            class="chip"
            data-map-target="filterButton"
            data-action="click->map#filterByCategory"
            data-category="wellness">
            🧘 Wellness
          </button>
        </div>
      </div>
    </div>

    <% if user_signed_in? && @recent_saved_spots_by_category.present? %>
      <section class="recent-spots">
        <div class="recent-spots__heading">
          <p class="recent-spots__eyebrow">
            Your collection
          </p>

          <h2 class="recent-spots__title">
            My saved spots
          </h2>
        </div>

        <% @recent_saved_spots_by_category.each do |category, spots| %>
          <div class="recent-spots__category">
            <h3 class="recent-spots__category-title">
              <%= category_emoji(category) %>
              <%= category.capitalize %>
            </h3>

            <div class="recent-spots__grid">
              <% spots.each do |spot| %>
                <%= link_to spot_path(spot),
                            class: "recent-spot-card shadow-box" do %>

                  <div class="recent-spot-card__emoji">
                    <%= category_emoji(spot.category) %>
                  </div>

                  <h4>
                    <%= spot.name %>
                  </h4>

                  <p>
                    <%= spot.address %>
                  </p>

                  <span class="tag">
                    <%= spot.category %>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </section>
    <% end %>
  </div>
</div>
